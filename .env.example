# Copy to .env and fill values yourself. Never commit .env.
# Multiple keys per provider are comma-separated pools: KEYS=key1,key2
# Numbered aliases (FOO_KEYS_1, FOO_API_KEY_2) are merged into the same pool.
# Logs and errors refer to key *index* only (0, 1, …), never the secret.

# --- Phase 2: Binance public market data via ccxt needs NO key ---

# --- Phase 6: structured research ---
FINNHUB_KEYS=
FINNHUB_KEYS_1=
FINNHUB_KEYS_2=
NEWSAPI_KEYS=
FRED_API_KEY=
GOLD_API_KEY=
TWELVE_DATA_KEYS=
TWELVE_DATA_API_KEY_1=
TWELVE_DATA_API_KEY_2=
ALPHA_VANTAGE_KEYS=
ALPHA_VANTAGE_KEY_1=
COINGECKO_API_KEY=
CRYPTOPANIC_KEYS=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# --- Phase 7: LLM (Ollama needs no key; Anthropic does) ---
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# --- Phase 9: forex / live broker (disabled by default; do not enable) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
BROKER_API_KEYS=
