# Copy to .env and fill values yourself. Never commit .env.
# Multiple keys per provider are comma-separated pools: KEYS=key1,key2
# Logs and errors refer to key *index* only (0, 1, …), never the secret.

# --- Phase 2: Binance public market data via ccxt needs NO key ---

# --- Phase 6: structured research (fill only when that phase asks) ---
FINNHUB_KEYS=
NEWSAPI_KEYS=
FRED_API_KEY=
COINGECKO_API_KEY=
CRYPTOPANIC_KEYS=

# --- Phase 7: LLM (Ollama needs no key; Anthropic does) ---
ANTHROPIC_API_KEY=
# Optional override; default is local OpenAI-compatible Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# --- Phase 9: forex / live broker (disabled by default; do not enable) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
BROKER_API_KEYS=
